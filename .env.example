# Server
PORT=8080
HOST=0.0.0.0

# Database
DB_PATH=./data/kpuppy.db

# Admin panel credentials
# Generate hash with: go run ./cmd/hashpass yourpassword
ADMIN_USER=admin
ADMIN_PASS_HASH=

# Rate limiting
RATE_LIMIT=true

# Sentry / Bugsink (optional)
# Set your DSN to enable error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
